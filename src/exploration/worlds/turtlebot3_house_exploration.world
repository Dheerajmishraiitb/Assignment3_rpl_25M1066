    <!-- ============================================================
         ASSIGNMENT 3 EXPLORATION OBSTACLES

         These obstacles are used only for Tasks 4-6.
         Their purpose is to create occlusion, multiple frontier
         components, and more interesting exploration choices.
         ============================================================ -->

    <!-- ASSIGNMENT 3 EXPLORATION OBSTACLES -->

    <model name="exploration_box_1">
      <static>true</static>
      <pose>-4.65 1.25 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.10 0.50 0.80</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.10 0.50 0.80</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.35 0.10 1</ambient>
            <diffuse>0.65 0.35 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
<model name="exploration_box_3">
      <static>true</static>
      <pose>-1.55 1.25 0.40 0 0 0.45</pose>
