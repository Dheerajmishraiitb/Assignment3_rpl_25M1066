    <!-- ===== room letters (floor decals) ===== -->

    <!-- room A: nw_bookshelf -->
    <include>
      <uri>model://room_label_A</uri>
      <name>room_label_A</name>
      <pose>-6.2500 3.0500 0.0 0 0 0</pose>
    </include>

    <!-- room B: n_centre -->
