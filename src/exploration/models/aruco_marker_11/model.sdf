<?xml version="1.0"?>
<sdf version="1.6">
  <model name="aruco_marker_11">
    <static>true</static>
    <link name="link">
      <!-- Visual only: the plate is flush against a wall, a collision here
           would just fight with the wall geometry. -->
      <visual name="plate">
        <geometry>
          <box>
            <size>0.01 0.16 0.16</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://aruco_marker_11/materials/scripts</uri>
            <uri>model://aruco_marker_11/materials/textures</uri>
            <name>CS7001/ArucoMarker11</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
